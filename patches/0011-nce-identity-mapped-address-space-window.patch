new file mode 100644
index 000000000..428479d43
--- /dev/null
+++ b/src/Ryujinx.Cpu/IdentityWindowPlacement.cs
@@ -0,0 +1,72 @@
+using System;
+
+namespace Ryujinx.Cpu
+{
+    /// <summary>
+    /// Pure placement math for the NCE identity-mapped address space window.
+    /// Kept free of OS calls so it can be unit tested on any host.
+    /// </summary>
+    public static class IdentityWindowPlacement
+    {
+        /// <summary>Host user VA limit assumed for NCE (39-bit, 4 KiB pages on Android arm64).</summary>
+        public const ulong HostVaLimit = 1UL << 39;
+
+        /// <summary>Lower bound for the window: Qualcomm GPU drivers need guest memory above 36 bits.</summary>
+        public const ulong MinimumBase = 1UL << 36;
+
+        /// <summary>Window alignment (L2 block / transparent huge page size).</summary>
+        public const ulong Alignment = 0x200000;
+
+        /// <summary>Eden's default reservation size.</summary>
+        public const ulong PreferredSize = 1UL << 38;
+
+        /// <summary>Smallest window that still fits a (shrunken) 39-bit region layout.</summary>
+        public const ulong MinimumSize = 1UL << 37;
+
+        /// <summary>
+        /// Picks a candidate base address for a window of <paramref name="size"/> bytes using
+        /// <paramref name="randomValue"/> as the entropy source.
+        /// </summary>
+        /// <returns>An aligned base in <c>[MinimumBase, HostVaLimit - size]</c>, or 0 if the size cannot fit.</returns>
+        public static ulong PickHint(ulong size, long randomValue)
+        {
+            if (size == 0 || size > HostVaLimit - MinimumBase)
+            {
+                return 0;
+            }
+
+            ulong lower = MinimumBase / Alignment;
+            ulong upper = (HostVaLimit - size) / Alignment;
+
+            if (upper < lower)
+            {
+                return 0;
+            }
+
+            ulong range = upper - lower + 1;
+            ulong slot = ((ulong)randomValue % range) + lower;
+
+            return slot * Alignment;
+        }
+
+        /// <summary>
+        /// Returns true if <c>[base, base + size)</c> is a valid identity window.
+        /// </summary>
+        public static bool IsValidWindow(ulong baseAddress, ulong size)
+        {
+            if (size == 0 || (baseAddress % Alignment) != 0)
+            {
+                return false;
+            }
+
+            if (baseAddress < MinimumBase)
+            {
+                return false;
+            }
+
+            ulong end = baseAddress + size;
+
+            return end > baseAddress && end <= HostVaLimit;
+        }
+    }
+}
