+        /// <summary>
+        /// Reserves a single, identity-mapped guest address space window for NCE.
+        /// </summary>
+        /// <remarks>
+        /// Mirrors Eden's <c>HostMemory::ChooseVirtualBase</c>: the window is placed at a random
+        /// 2 MiB aligned host address inside <c>[2^36, 2^39 - size)</c> so that every guest VA
+        /// is a valid 39-bit host pointer, the whole window lies above 36 bits (required by
+        /// Qualcomm GPU drivers), and no address translation is needed between guest and host.
+        /// Tries <paramref name="preferredSize"/> first (Eden uses 2^38), then halves until
+        /// <paramref name="minimumSize"/>.
+        /// </remarks>
+        /// <param name="preferredSize">Preferred window size (power of two)</param>
+        /// <param name="minimumSize">Smallest acceptable window size (power of two)</param>
+        /// <param name="addressSpace">Reserved window on success</param>
+        /// <param name="attemptsPerSize">Random placements to try per size</param>
+        /// <returns>True if a window was reserved</returns>
+        public static bool TryCreateIdentityWindow(ulong preferredSize, ulong minimumSize, out MemoryBlock addressSpace, int attemptsPerSize = 64)
+        {
+            addressSpace = null;
+
+            Random rng = new();
+
+            for (ulong size = preferredSize; size >= minimumSize && size != 0; size >>= 1)
+            {
+                for (int attempt = 0; attempt < attemptsPerSize; attempt++)
+                {
+                    ulong hint = IdentityWindowPlacement.PickHint(size, rng.NextInt64());
+
+                    if (hint == 0)
+                    {
+                        break;
+                    }
+
+                    if (MemoryBlock.TryReserveAt(size, (nint)hint, out addressSpace))
+                    {
+                        return true;
+                    }
+                }
+            }
+
+            return false;
+        }
+
         public void Map(ulong va, ulong pa, ulong size, MemoryMapFlags flags)
         {
             Base.MapView(_backingMemory, pa, va, size);
