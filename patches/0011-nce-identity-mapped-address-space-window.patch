+        /// <summary>
+        /// Reserves <paramref name="size"/> bytes exactly at <paramref name="address"/>, without
+        /// replacing any existing mapping. Returns <see cref="nint.Zero"/> if the range is not free.
+        /// Used by NCE to place the guest address space at a chosen host address so that
+        /// guest VA == host pointer.
+        /// </summary>
+        public static nint ReserveAt(nint address, ulong size)
+        {
+            MmapFlags flags = MmapFlags.MAP_ANONYMOUS | MmapFlags.MAP_PRIVATE | MmapFlags.MAP_NORESERVE | MmapFlags.MAP_FIXED_NOREPLACE;
+
+            nint ptr = Mmap(address, size, MmapProts.PROT_NONE, flags, -1, 0);
+
+            if (ptr == MAP_FAILED)
+            {
+                return nint.Zero;
+            }
+
+            // Kernels without MAP_FIXED_NOREPLACE treat the address as a hint and may
+            // return a different range: that is not what we asked for, so release it.
+            if (ptr != address)
+            {
+                munmap(ptr, size);
+
+                return nint.Zero;
+            }
+
+            if (!_allocations.TryAdd(ptr, size))
+            {
+                munmap(ptr, size);
+
+                throw new InvalidOperationException();
+            }
+
+            return ptr;
+        }
+
         private static nint AllocateInternal(ulong size, MmapProts prot, bool forJit, bool shared = false)
         {
             MmapFlags flags = MmapFlags.MAP_ANONYMOUS;
