-        public KPageTableBase(KernelContext context, ulong reservedAddressSpaceSize)
+        /// <summary>
+        /// True when the process address space is identity mapped (guest VA == host pointer, NCE).
+        /// The whole 39-bit layout is then offset by <see cref="_reservedAddressSpaceBase"/>.
+        /// </summary>
+        public bool IsIdentityMapped => _reservedAddressSpaceBase != 0;
+
+        /// <param name="context">Kernel context</param>
+        /// <param name="reservedAddressSpaceSize">Size of the host reservation backing this address space</param>
+        /// <param name="reservedAddressSpaceBase">
+        /// Guest VA of the first byte of the host reservation. Zero for the classic layout
+        /// (guest VA 0 maps to the reservation base); non-zero for NCE identity mapping,
+        /// where the guest VA is the host pointer (Eden's <c>aslr_space_start</c>).
+        /// </param>
+        public KPageTableBase(KernelContext context, ulong reservedAddressSpaceSize, ulong reservedAddressSpaceBase = 0)
         {
             Context = context;
 
@@ -96,6 +111,7 @@ namespace Ryujinx.HLE.HOS.Kernel.Memory
             _ipcFillValue = MemoryFillValue.Zero;
 
             _reservedAddressSpaceSize = reservedAddressSpaceSize;
+            _reservedAddressSpaceBase = reservedAddressSpaceBase;
         }
 
         public Result InitializeForProcess(
@@ -177,6 +193,12 @@ namespace Ryujinx.HLE.HOS.Kernel.Memory
             ulong stackAndTlsIoStart;
             ulong stackAndTlsIoEnd;
 
+            // Upper bound for placing the alias/heap/stack/tlsio regions. Normally the end of
+            // the address space; the NCE identity window narrows it so every region the kernel
+            // can hand out is host-backed (0 = "use addrSpaceEnd", resolved after the switch).
+            ulong mapLimit = 0;
+            ulong identityWindowSize = 0;
+
             AliasRegionExtraSize = 0;
 
             switch (flags & ProcessCreationFlags.AddressSpaceMask)
@@ -221,7 +243,54 @@ namespace Ryujinx.HLE.HOS.Kernel.Memory
                     break;
 
                 case ProcessCreationFlags.AddressSpace64Bit:
-                    if (_reservedAddressSpaceSize < addrSpaceEnd)
+                    if (_reservedAddressSpaceBase != 0)
+                    {
+                        // NCE identity-mapped address space (Eden's aslr_space_start): the guest
+                        // VA *is* the host pointer, so the whole 39-bit layout is offset by the
+                        // base of the host reservation and confined to it. Everything the kernel
+                        // can hand to the guest (code, alias, heap, stack, TLS/IO) is therefore
+                        // host-backed and directly dereferenceable by natively executing code.
+                        //
+                        // The *address space* itself stays [0, 2^39) exactly like real hardware
+                        // (and Eden's m_address_space_start/end): rtld discovers the loaded NSOs
+                        // by walking QueryMemory from address 0 until the cursor wraps, and the
+                        // SDK's virtual-memory allocator does the same over the ASLR region. If
+                        // the space started at the window base, QueryMemory(0) would return the
+                        // "outside" descriptor whose end wraps to 0 and the walk would stop
+                        // before ever seeing a module ("[rtld] Unresolved symbol: nn::init::Start").
+                        // Only region *placement* is bounded to the window (mapLimit).
+                        ulong windowStart = _reservedAddressSpaceBase;
+                        ulong windowEnd = Math.Min(windowStart + _reservedAddressSpaceSize, addrSpaceEnd);
+                        ulong windowSize = windowEnd - windowStart;
+
+                        if (windowSize >= 0x4000000000UL)
+                        {
+                            // Full-size regions (same as the real 39-bit layout) fit in >= 256 GiB.
+                            aliasRegion.Size = 0x1000000000;
+                            heapRegion.Size = memConfig == MemoryConfiguration.MemoryConfiguration12GiB ? 0x300000000u : 0x180000000u;
+                            stackRegion.Size = 0x80000000;
+                            tlsIoRegion.Size = 0x1000000000;
+                        }
+                        else
+                        {
+                            int addressSpaceWidth = (int)ulong.Log2(windowSize);
+
+                            aliasRegion.Size = 1UL << (addressSpaceWidth - 3);
+                            heapRegion.Size = memConfig == MemoryConfiguration.MemoryConfiguration12GiB ? 0x300000000u : 0x180000000u;
+                            stackRegion.Size = 1UL << (addressSpaceWidth - 8);
+                            tlsIoRegion.Size = 1UL << (addressSpaceWidth - 3);
+                        }
+
+                        CodeRegionStart = BitUtils.AlignDown(address, RegionAlignment);
+                        codeRegionSize = BitUtils.AlignUp(endAddr, RegionAlignment) - CodeRegionStart;
+                        stackAndTlsIoStart = 0;
+                        stackAndTlsIoEnd = 0;
+                        AslrRegionStart = windowStart + 0x8000000;
+                        AslrRegionEnd = windowEnd;
+                        mapLimit = windowEnd;
+                        identityWindowSize = windowSize;
+                    }
+                    else if (_reservedAddressSpaceSize < addrSpaceEnd)
                     {
                         int addressSpaceWidth = (int)ulong.Log2(_reservedAddressSpaceSize);
 
@@ -253,7 +322,12 @@ namespace Ryujinx.HLE.HOS.Kernel.Memory
 
                     if (flags.HasFlag(ProcessCreationFlags.EnableAliasRegionExtraSize))
                     {
-                        AliasRegionExtraSize = addrSpaceEnd / 8;
+                        // Real kernel / Eden: 1/8 of the address space (64 GiB for 39-bit). A
+                        // shrunken identity window (< 256 GiB) cannot afford that, so scale it
+                        // with the window instead.
+                        AliasRegionExtraSize = identityWindowSize != 0 && identityWindowSize < 0x4000000000UL
+                            ? identityWindowSize / 8
+                            : (addrSpaceEnd - addrSpaceStart) / 8;
                         aliasRegion.Size += AliasRegionExtraSize;
                     }
 
@@ -265,10 +339,15 @@ namespace Ryujinx.HLE.HOS.Kernel.Memory
 
             CodeRegionEnd = CodeRegionStart + codeRegionSize;
 
+            if (mapLimit == 0)
+            {
+                mapLimit = addrSpaceEnd;
+            }
+
             ulong mapBaseAddress;
             ulong mapAvailableSize;
 
-            if (CodeRegionStart - AslrRegionStart >= addrSpaceEnd - CodeRegionEnd)
+            if (CodeRegionStart - AslrRegionStart >= mapLimit - CodeRegionEnd)
             {
                 // Has more space before the start of the code region.
                 mapBaseAddress = AslrRegionStart;
@@ -278,7 +357,7 @@ namespace Ryujinx.HLE.HOS.Kernel.Memory
             {
                 // Has more space after the end of the code region.
                 mapBaseAddress = CodeRegionEnd;
-                mapAvailableSize = addrSpaceEnd - CodeRegionEnd;
+                mapAvailableSize = mapLimit - CodeRegionEnd;
             }
 
             ulong mapTotalSize = aliasRegion.Size + heapRegion.Size + stackRegion.Size + tlsIoRegion.Size;
@@ -362,6 +441,18 @@ namespace Ryujinx.HLE.HOS.Kernel.Memory
             TlsIoRegionStart = tlsIoRegion.Start;
             TlsIoRegionEnd = tlsIoRegion.End;
 
+            if (IsIdentityMapped)
+            {
+                // Structured line for NCE smoke triage: every region must lie inside the
+                // identity window or natively executing guest code cannot touch it.
+                Logger.Info?.Print(LogClass.Kernel,
+                    $"NCE|LAYOUT as=[0x{addrSpaceStart:X},0x{addrSpaceEnd:X}) window=[0x{_reservedAddressSpaceBase:X},0x{mapLimit:X}) " +
+                    $"code=[0x{CodeRegionStart:X},0x{CodeRegionEnd:X}) " +
+                    $"aslr=[0x{AslrRegionStart:X},0x{AslrRegionEnd:X}) alias=[0x{AliasRegionStart:X},0x{AliasRegionEnd:X}) " +
+                    $"heap=[0x{HeapRegionStart:X},0x{HeapRegionEnd:X}) stack=[0x{StackRegionStart:X},0x{StackRegionEnd:X}) " +
+                    $"tlsio=[0x{TlsIoRegionStart:X},0x{TlsIoRegionEnd:X}) aslrEnabled={aslrEnabled}");
+            }
+
             // TODO: Check kernel configuration via secure monitor call when implemented to set memory fill values.
 
             _currentHeapAddr = HeapRegionStart;
