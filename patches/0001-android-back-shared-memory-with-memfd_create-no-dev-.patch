From 97f85b8eb1d0ce311996bfe13a7e219cbc5d3164 Mon Sep 17 00:00:00 2001
From: Jochem Kuipers <jochem@kuipers.cc>
Date: Tue, 7 Jul 2026 18:47:58 +0200
Subject: [PATCH] android: back shared memory with memfd_create (no /dev/shm on
 bionic)

---
 src/Ryujinx.Memory/MemoryManagementUnix.cs    | 18 ++++++++++++++++++
 src/Ryujinx.Memory/MemoryManagerUnixHelper.cs |  6 ++++++
 2 files changed, 24 insertions(+)

diff --git a/src/Ryujinx.Memory/MemoryManagementUnix.cs b/src/Ryujinx.Memory/MemoryManagementUnix.cs
index 76a63a466..054539f24 100644
--- a/src/Ryujinx.Memory/MemoryManagementUnix.cs
+++ b/src/Ryujinx.Memory/MemoryManagementUnix.cs
@@ -156,6 +156,23 @@ namespace Ryujinx.Memory
                     }
                 }
             }
+#if ANDROID
+            else
+            {
+                // bionic has no /dev/shm, so mkstemp there fails with ENOENT. Back the
+                // shared memory with an anonymous memfd (available since API 30) instead.
+                byte[] memName = "ryubing-shared\0"u8.ToArray();
+
+                fixed (byte* pMemName = memName)
+                {
+                    fd = memfd_create((nint)pMemName, 0);
+                    if (fd == -1)
+                    {
+                        throw new SystemException(Marshal.GetLastPInvokeErrorMessage());
+                    }
+                }
+            }
+#else
             else
             {
                 byte[] fileName = "/dev/shm/Ryujinx-XXXXXX"u8.ToArray();
@@ -174,6 +191,7 @@ namespace Ryujinx.Memory
                     }
                 }
             }
+#endif
 
             if (ftruncate(fd, (nint)size) != 0)
             {
diff --git a/src/Ryujinx.Memory/MemoryManagerUnixHelper.cs b/src/Ryujinx.Memory/MemoryManagerUnixHelper.cs
index e5a0b7a4d..4638b633a 100644
--- a/src/Ryujinx.Memory/MemoryManagerUnixHelper.cs
+++ b/src/Ryujinx.Memory/MemoryManagerUnixHelper.cs
@@ -74,6 +74,12 @@ namespace Ryujinx.Memory
         [LibraryImport("libc", SetLastError = true)]
         public static partial int mkstemp(nint template);
 
+#if ANDROID
+        // Android has no /dev/shm; anonymous in-memory files back shared memory instead.
+        [LibraryImport("libc", SetLastError = true)]
+        public static partial int memfd_create(nint name, uint flags);
+#endif
+
         [LibraryImport("libc", SetLastError = true)]
         public static partial int unlink(nint pathname);
 
-- 
2.55.0.windows.2

