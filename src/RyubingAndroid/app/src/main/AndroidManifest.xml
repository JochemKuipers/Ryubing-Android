<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      All Files Access. The emulator core re-opens SAF file descriptors by path
      (/proc/self/fd/N) inside libryubing.so. Since Android 14 the FUSE storage daemon
      re-validates path access on that re-open; for non-media files (ROMs) in shared
      storage the check only passes when this app holds All Files Access. Without it,
      game probing/loading fails with EACCES while SAF copies (e.g. prod.keys import)
      still work. (Kenji-NX parity: it declares the same permission.)
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Pre-Android-13 devices: READ is runtime-granted alongside MANAGE on 13+. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Vulkan 1.1+ is required; arm64 high-end devices only (Kenji parity). -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x400003"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:isGame="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.Ryubing">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:launchMode="singleTop"
            android:screenOrientation="fullUser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
