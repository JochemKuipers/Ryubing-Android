{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "android",
            "request": "launch",
            "name": "Android: Launch & Debug",
            "preLaunchTask": "android: prepare debug launch",
            "appSrcRoot": "${workspaceFolder}/src/RyubingAndroid/app/src/main",
            "apkFile": "${workspaceFolder}/src/RyubingAndroid/app/build/outputs/apk/debug/app-debug.apk",
            "manifestFile": "${workspaceFolder}/src/RyubingAndroid/app/src/main/AndroidManifest.xml",
            "launchActivity": ".MainActivity",
            "pmInstallArgs": ["-r", "-d"],
            "staleBuild": "ignore",
            "targetDevice": "",
            "autoStartADB": true,
            "adbSocket": "localhost:5037",
            "postLaunchPause": 1500,
            "trace": true
        },
        {
            "type": "android",
            "request": "attach",
            "name": "Android: Attach to Process",
            "appSrcRoot": "${workspaceFolder}/src/RyubingAndroid/app/src/main",
            "processId": "${command:PickAndroidProcess}",
            "targetDevice": "",
            "adbSocket": "localhost:5037",
            "trace": true
        },
        {
            "name": "Android: Run (deploy + logcat)",
            "type": "node-terminal",
            "request": "launch",
            "command": "${workspaceFolder}/scripts/android-deploy.sh deploy-logcat",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Android: Logcat",
            "type": "node-terminal",
            "request": "launch",
            "command": "${workspaceFolder}/scripts/android-deploy.sh logcat",
            "cwd": "${workspaceFolder}"
        }
    ]
}
